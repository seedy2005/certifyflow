# Copy to .env and replace the example values before starting. Never commit .env.
CERTIBOT_ENV=development
CERTIBOT_SESSION_SECRET=replace-with-a-random-value-at-least-32-characters
CERTIBOT_ADMIN_USERNAME=organizer
CERTIBOT_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
CERTIBOT_COOKIE_SECURE=false
CERTIBOT_ALLOWED_HOSTS=localhost,127.0.0.1
CERTIBOT_CORS_ORIGINS=
CERTIBOT_DATA_DIR=./data
CERTIBOT_MAX_UPLOAD_MB=25
CERTIBOT_MAX_SPREADSHEET_EXPANDED_MB=100
CERTIBOT_ENABLE_API_DOCS=false
GOOGLE_FONTS_API_KEY=
DOMAIN=certificates.example.com
