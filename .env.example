# Copy to .env and replace the example values before starting. Never commit .env.
CERTIFYFLOW_ENV=development
CERTIFYFLOW_SESSION_SECRET=replace-with-a-random-value-at-least-32-characters
CERTIFYFLOW_ADMIN_USERNAME=organizer
CERTIFYFLOW_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
CERTIFYFLOW_COOKIE_SECURE=false
CERTIFYFLOW_ALLOWED_HOSTS=localhost,127.0.0.1
CERTIFYFLOW_CORS_ORIGINS=
CERTIFYFLOW_DATA_DIR=./data
CERTIFYFLOW_MAX_UPLOAD_MB=25
CERTIFYFLOW_MAX_SPREADSHEET_EXPANDED_MB=100
CERTIFYFLOW_ENABLE_API_DOCS=false
GOOGLE_FONTS_API_KEY=
DOMAIN=certificates.example.com
